  {
    "id": "sw_r1",
    "type": "switch",
    "z": "tab_smart_campus",
    "g": "grp_rules",
    "name": "AC6: start is HH:MM?",
    "property": "payload.start",
    "propertyType": "msg",
    "rules": [
      {
        "t": "regex",
        "v": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
        "vt": "str",
        "case": false
      },
      {
        "t": "else"
      }
    ],
    "checkall": "false",
    "repair": false,
    "outputs": 2,
    "x": 290,
    "y": 180,
    "wires": [
      [
        "sw_r2"
      ],
      [
        "res_invalid_start"
      ]
    ]
  },
  {
    "id": "sw_r2",
    "type": "switch",
    "z": "tab_smart_campus",
    "g": "grp_rules",
    "name": "AC2: duration whole 1-120?",
    "property": "payload.duration",
    "propertyType": "msg",
    "rules": [
      {
        "t": "regex",
        "v": "^0*([1-9]|[1-9][0-9]|1[01][0-9]|120)$",
        "vt": "str",
        "case": false
      },
      {
        "t": "else"
      }
    ],
    "checkall": "false",
    "repair": false,
    "outputs": 2,
    "x": 540,
    "y": 180,
    "wires": [
      [
        "chg_minutes"
      ],
      [
        "res_invalid_dur"
      ]
    ]
  },
  {
    "id": "chg_minutes",
    "type": "change",
    "z": "tab_smart_campus",
    "g": "grp_rules",
    "name": "to minutes (req.*)",
    "rules": [
      {
        "t": "set",
        "p": "req.start",
        "pt": "msg",
        "to": "payload.start",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "req.startMin",
        "pt": "msg",
        "to": "$number($substringBefore(payload.start, \":\")) * 60 + $number($substringAfter(payload.start, \":\"))",
        "tot": "jsonata"
      },
      {
        "t": "set",
        "p": "req.duration",
        "pt": "msg",
        "to": "$number(payload.duration)",
        "tot": "jsonata"
      },
      {
        "t": "set",
        "p": "req.endMin",
        "pt": "msg",
        "to": "req.startMin + req.duration",
        "tot": "jsonata"
      },
      {
        "t": "set",
        "p": "req.blocked",
        "pt": "msg",
        "to": "payload.blocked = true",
        "tot": "jsonata"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 760,
    "y": 180,
    "wires": [
      [
        "sw_r3"
      ]
    ]
  },
  {
    "id": "sw_r3",
    "type": "switch",
    "z": "tab_smart_campus",
    "g": "grp_rules",
    "name": "AC1: start after 09:00?",
    "property": "req.startMin",
    "propertyType": "msg",
    "rules": [
      {
        "t": "gt",
        "v": "nowMin",
        "vt": "flow"
      },
      {
        "t": "else"
      }
    ],
    "checkall": "false",
    "repair": false,
    "outputs": 2,
    "x": 300,
    "y": 260,
    "wires": [
      [
        "sw_r4"
      ],
      [
        "res_past"
      ]
    ]
  },
