  {
    "id": "chg_find",
    "type": "change",
    "z": "tab_smart_campus",
    "g": "grp_rules",
    "name": "find first overlapping booking",
    "rules": [
      {
        "t": "set",
        "p": "req.conflict",
        "pt": "msg",
        "to": "$flowContext(\"bookings\")[($number($substringBefore(start, \":\")) * 60 + $number($substringAfter(start, \":\"))) < $$.req.endMin and ($number($substringBefore(end, \":\")) * 60 + $number($substringAfter(end, \":\"))) > $$.req.startMin][0]",
        "tot": "jsonata"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 320,
